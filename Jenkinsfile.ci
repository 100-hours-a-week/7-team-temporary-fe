pipeline {
  agent any

  options {
    skipDefaultCheckout(true)
    disableConcurrentBuilds()
    timestamps()
    buildDiscarder(logRotator(numToKeepStr: "30"))
  }

  stages {
    stage("Checkout") {
      steps {
        checkout scm
      }
    }

    stage("Resolve build metadata") {
      steps {
        sh '''
          set -eu
          SHORT_SHA="$(git rev-parse --short=7 HEAD)"
          BRANCH_RAW="${BRANCH_NAME:-detached}"
          BRANCH_SLUG="$(echo "$BRANCH_RAW" | tr '/:' '--' | tr -cd '[:alnum:]._-')"
          [ -n "$BRANCH_SLUG" ] || BRANCH_SLUG="detached"
          LOCAL_IMAGE="molip-fe:${SHORT_SHA}"

          cat > .ci-meta.env <<META
SHORT_SHA=${SHORT_SHA}
BRANCH_SLUG=${BRANCH_SLUG}
LOCAL_IMAGE=${LOCAL_IMAGE}
META
        '''
      }
    }

    stage("Build Docker image") {
      steps {
        script {
          def isDeployBranch = !env.CHANGE_ID?.trim() && ((env.BRANCH_NAME ?: "") == "main" || (env.BRANCH_NAME ?: "").startsWith("release/"))
          def apiBaseCredential = (env.BRANCH_NAME ?: "").startsWith("release/")
            ? "next-public-api-base-url-staging"
            : "next-public-api-base-url-production"

          def buildScript = '''
            set -eu
            command -v docker >/dev/null 2>&1 || { echo "docker is required on Jenkins agent"; exit 1; }
            . ./.ci-meta.env

            : "${NEXT_PUBLIC_API_BASE_URL:=}"
            : "${NEXT_PUBLIC_ENABLE_SW:=}"
            : "${NEXT_PUBLIC_FIREBASE_API_KEY:=}"
            : "${NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN:=}"
            : "${NEXT_PUBLIC_FIREBASE_PROJECT_ID:=}"
            : "${NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET:=}"
            : "${NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID:=}"
            : "${NEXT_PUBLIC_FIREBASE_APP_ID:=}"
            : "${NEXT_PUBLIC_FIREBASE_VAPID_KEY:=}"

            DOCKER_BUILDKIT=1 docker build \
              --build-arg NEXT_PUBLIC_API_BASE_URL="$NEXT_PUBLIC_API_BASE_URL" \
              --build-arg NEXT_PUBLIC_ENABLE_SW="$NEXT_PUBLIC_ENABLE_SW" \
              --build-arg NEXT_PUBLIC_FIREBASE_API_KEY="$NEXT_PUBLIC_FIREBASE_API_KEY" \
              --build-arg NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="$NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN" \
              --build-arg NEXT_PUBLIC_FIREBASE_PROJECT_ID="$NEXT_PUBLIC_FIREBASE_PROJECT_ID" \
              --build-arg NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="$NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET" \
              --build-arg NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="$NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID" \
              --build-arg NEXT_PUBLIC_FIREBASE_APP_ID="$NEXT_PUBLIC_FIREBASE_APP_ID" \
              --build-arg NEXT_PUBLIC_FIREBASE_VAPID_KEY="$NEXT_PUBLIC_FIREBASE_VAPID_KEY" \
              -t "$LOCAL_IMAGE" .
          '''

          if (isDeployBranch) {
            withCredentials([
              string(credentialsId: apiBaseCredential, variable: "NEXT_PUBLIC_API_BASE_URL"),
              string(credentialsId: "next-public-enable-sw", variable: "NEXT_PUBLIC_ENABLE_SW"),
              string(credentialsId: "next-public-firebase-api-key", variable: "NEXT_PUBLIC_FIREBASE_API_KEY"),
              string(credentialsId: "next-public-firebase-auth-domain", variable: "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN"),
              string(credentialsId: "next-public-firebase-project-id", variable: "NEXT_PUBLIC_FIREBASE_PROJECT_ID"),
              string(credentialsId: "next-public-firebase-storage-bucket", variable: "NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET"),
              string(credentialsId: "next-public-firebase-messaging-sender-id", variable: "NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID"),
              string(credentialsId: "next-public-firebase-app-id", variable: "NEXT_PUBLIC_FIREBASE_APP_ID"),
              string(credentialsId: "next-public-firebase-vapid-key", variable: "NEXT_PUBLIC_FIREBASE_VAPID_KEY")
            ]) {
              sh buildScript
            }
          } else {
            sh buildScript
          }
        }
      }
    }

    stage("Smoke test container") {
      steps {
        sh '''
          set -eu
          command -v docker >/dev/null 2>&1 || { echo "docker is required on Jenkins agent"; exit 1; }
          . ./.ci-meta.env

          CONTAINER_NAME="ci-smoke-${SHORT_SHA}"
          docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true

          docker run -d --rm --name "$CONTAINER_NAME" "$LOCAL_IMAGE" >/dev/null

          i=0
          until [ "$i" -ge 30 ]; do
            if docker logs "$CONTAINER_NAME" 2>&1 | grep -q "Ready"; then
              echo "Container smoke test passed"
              break
            fi
            i=$((i + 1))
            sleep 2
          done

          if [ "$i" -ge 30 ]; then
            echo "Container did not become ready in time"
            docker logs "$CONTAINER_NAME" || true
            exit 1
          fi

          docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true
        '''
      }
    }

    stage("Push image to ECR") {
      when {
        expression {
          return !env.CHANGE_ID?.trim() && ((env.BRANCH_NAME ?: "") == "main" || (env.BRANCH_NAME ?: "").startsWith("release/"))
        }
      }
      steps {
        withCredentials([
          string(credentialsId: "aws-access-key-id", variable: "AWS_ACCESS_KEY_ID"),
          string(credentialsId: "aws-secret-access-key", variable: "AWS_SECRET_ACCESS_KEY"),
          string(credentialsId: "aws-region", variable: "AWS_REGION"),
          string(credentialsId: "aws-account-id", variable: "AWS_ACCOUNT_ID"),
          string(credentialsId: "ecr-repo", variable: "ECR_REPO")
        ]) {
          sh '''
            set -eu
            command -v aws >/dev/null 2>&1 || { echo "aws cli is required on Jenkins agent"; exit 1; }
            command -v docker >/dev/null 2>&1 || { echo "docker is required on Jenkins agent"; exit 1; }
            . ./.ci-meta.env

            export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_DEFAULT_REGION="$AWS_REGION"

            REGISTRY="$AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com"
            REMOTE_IMAGE="$REGISTRY/$ECR_REPO:$SHORT_SHA"
            BRANCH_LATEST_IMAGE="$REGISTRY/$ECR_REPO:${BRANCH_SLUG}-latest"

            aws ecr describe-repositories --repository-names "$ECR_REPO" --region "$AWS_REGION" >/dev/null 2>&1 || \
              aws ecr create-repository --repository-name "$ECR_REPO" --region "$AWS_REGION" >/dev/null

            aws ecr get-login-password --region "$AWS_REGION" | \
              docker login --username AWS --password-stdin "$REGISTRY"

            docker tag "$LOCAL_IMAGE" "$REMOTE_IMAGE"
            docker tag "$LOCAL_IMAGE" "$BRANCH_LATEST_IMAGE"

            docker push "$REMOTE_IMAGE"
            docker push "$BRANCH_LATEST_IMAGE"

            cat > image-info.env <<META
IMAGE_URI=${REMOTE_IMAGE}
IMAGE_TAG=${SHORT_SHA}
IMAGE_BRANCH_LATEST=${BRANCH_LATEST_IMAGE}
META
          '''
        }
      }
    }
  }

  post {
    always {
      script {
        def hasWorkspace = (env.WORKSPACE ?: "").trim()

        if (hasWorkspace) {
          sh '''
            set +e
            if [ -f .ci-meta.env ]; then
              . ./.ci-meta.env
              docker rm -f "ci-smoke-${SHORT_SHA}" >/dev/null 2>&1 || true
            fi
          '''
        } else {
          echo "Skip workspace cleanup: no workspace context"
        }

        def statusText = currentBuild.currentResult == "SUCCESS" ? "✅ CI 성공" : "🚨 CI 실패"
        def context = "Branch: ${env.BRANCH_NAME ?: "unknown"}"
        if (env.CHANGE_ID) {
          context = "PR #${env.CHANGE_ID} (${env.CHANGE_BRANCH ?: "unknown"} -> ${env.CHANGE_TARGET ?: "unknown"})"
        }

        if (hasWorkspace) {
          try {
            withCredentials([string(credentialsId: "discord-webhook-url", variable: "DISCORD_WEBHOOK_URL")]) {
              sh """
                set +e
                SHORT_SHA=\$(git rev-parse --short HEAD || echo unknown)
                curl -X POST "\$DISCORD_WEBHOOK_URL" \\
                  -H "Content-Type: application/json" \\
                  -d "{\\"content\\": \\\"${statusText}\\\\nRepo: ${env.JOB_NAME}\\\\n${context}\\\\nActor: ${env.CHANGE_AUTHOR ?: env.BUILD_USER_ID ?: "jenkins"}\\\\nCommit: \$SHORT_SHA\\\\nRun: ${env.BUILD_URL}\\\"}" || true
              """
            }
          } catch (err) {
            echo "Skip Discord notification: ${err}"
          }
        } else {
          echo "Skip Discord notification: no workspace context"
        }
      }
    }
    success {
      script {
        if ((env.WORKSPACE ?: "").trim()) {
          archiveArtifacts artifacts: 'image-info.env', allowEmptyArchive: true
        } else {
          echo "Skip artifact archive: no workspace context"
        }
      }
    }
  }
}
