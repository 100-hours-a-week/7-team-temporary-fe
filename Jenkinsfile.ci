pipeline {
  agent any

  options {
    skipDefaultCheckout(true)
    disableConcurrentBuilds()
    timestamps()
    buildDiscarder(logRotator(numToKeepStr: "30"))
  }

  environment {
    PNPM_VERSION = "9.15.1"
  }

  stages {
    stage("Checkout") {
      steps {
        checkout scm
      }
    }

    stage("Prepare pnpm") {
      steps {
        sh """
          set -euo pipefail
          command -v node >/dev/null 2>&1 || { echo "Node.js is required on Jenkins agent"; exit 1; }
          command -v corepack >/dev/null 2>&1 || { echo "corepack is required on Jenkins agent"; exit 1; }
          corepack enable
          corepack prepare pnpm@${PNPM_VERSION} --activate
          node --version
          pnpm --version
        """
      }
    }

    stage("Install dependencies") {
      steps {
        sh """
          set -euo pipefail
          pnpm install --frozen-lockfile
        """
      }
    }

    stage("Lint (PR only)") {
      when {
        expression {
          return env.CHANGE_ID?.trim()
        }
      }
      steps {
        sh "pnpm run lint"
      }
    }

    stage("Build") {
      steps {
        sh "pnpm run build"
      }
    }

    stage("Security Audit (main/release push only)") {
      when {
        expression {
          def isPr = env.CHANGE_ID?.trim()
          def branch = env.BRANCH_NAME ?: ""
          return !isPr && (branch == "main" || branch.startsWith("release/"))
        }
      }
      steps {
        sh "pnpm audit --audit-level=high"
      }
    }
  }

  post {
    always {
      script {
        def statusText = currentBuild.currentResult == "SUCCESS" ? "✅ CI 성공" : "🚨 CI 실패"
        def context = "Branch: ${env.BRANCH_NAME ?: "unknown"}"
        if (env.CHANGE_ID) {
          context = "PR #${env.CHANGE_ID} (${env.CHANGE_BRANCH ?: "unknown"} -> ${env.CHANGE_TARGET ?: "unknown"})"
        }

        withCredentials([string(credentialsId: "discord-webhook-url", variable: "DISCORD_WEBHOOK_URL")]) {
          sh """
            set +e
            SHORT_SHA=\$(git rev-parse --short HEAD || echo unknown)
            curl -X POST "\$DISCORD_WEBHOOK_URL" \\
              -H "Content-Type: application/json" \\
              -d "{\\"content\\": \\"${statusText}\\\\nRepo: ${env.JOB_NAME}\\\\n${context}\\\\nActor: ${env.CHANGE_AUTHOR ?: env.BUILD_USER_ID ?: "jenkins"}\\\\nCommit: \$SHORT_SHA\\\\nRun: ${env.BUILD_URL}\\"}" || true
          """
        }
      }
    }
  }
}
